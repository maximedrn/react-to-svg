{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "assist": {
    "actions": {
      "recommended": true,
      "source": {
        "organizeImports": "on",
        "useSortedAttributes": "on",
        "useSortedInterfaceMembers": "on",
        "useSortedKeys": "on",
        "useSortedProperties": "on"
      }
    },
    "enabled": true
  },
  "css": {
    "assist": { "enabled": true },
    "formatter": { "enabled": true, "quoteStyle": "double" },
    "linter": { "enabled": true },
    "parser": { "tailwindDirectives": true }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/node_modules", "!**/dist"]
  },
  "formatter": {
    "attributePosition": "multiline",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "trailingNewline": true,
    "useEditorconfig": false
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "enabled": false,
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    },
    "globals": ["Bun"],
    "linter": { "enabled": true }
  },
  "json": {
    "assist": { "enabled": true },
    "formatter": { "enabled": true },
    "linter": { "enabled": true }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": "error",
      "complexity": {
        "noExcessiveLinesPerFunction": "off"
      },
      "correctness": {
        "noUndeclaredDependencies": "off",
        "noUnresolvedImports": "off",
        "useQwikValidLexicalScope": "off"
      },
      "nursery": {
        "useExplicitType": "error",
        "useThisInClassMethods": "error"
      },
      "performance": "error",
      "preset": "all",
      "security": "error",
      "style": {
        "noExcessiveLinesPerFile": "off",
        "noTernary": "off",
        "useBlockStatements": "off",
        "useNamingConvention": {
          "level": "error",
          "options": { "strictCase": false }
        }
      },
      "suspicious": "error"
    }
  },
  "overrides": [
    {
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "off"
          }
        }
      },
      "includes": ["package.json"]
    },
    {
      "includes": ["**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": [
                  "camelCase",
                  "kebab-case",
                  "PascalCase",
                  "snake_case",
                  "export"
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": ["tsup.config.ts", "src/**/*.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**/*.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNamespace": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**/*.errors.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveClassesPerFile": "off"
          }
        }
      }
    },
    {
      "includes": ["src/resolve/resolve.host.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
